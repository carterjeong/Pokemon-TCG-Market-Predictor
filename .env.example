# ============================================================
# Copy to .env for local dev:  cp .env.example .env
# NEVER commit .env — in AWS these come from Secrets Manager.
# ============================================================

# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- PostgreSQL (docker-compose reads these too) ---
POSTGRES_USER=ptcg
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ptcg_market

# --- pokemontcg.io (Carter) — free key: https://dev.pokemontcg.io ---
POKEMONTCG_API_KEY=

# --- Auth placeholders (CyberSec) — real values via AWS Secrets Manager ---
JWT_SECRET_KEY=local-dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
